<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Gradiente de fundo escuro cyberpunk -->
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#111827"/>
      <stop offset="100%" stop-color="#1f293d"/>
    </linearGradient>
    
    <!-- Gradiente Neon Roxo/Digivice -->
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00d2ff"/>
      <stop offset="100%" stop-color="#a855f7"/>
    </linearGradient>
  </defs>

  <!-- Fundo Arredondado com Borda Glow -->
  <rect x="16" y="16" width="480" height="480" rx="96" fill="url(#bgGrad)" stroke="#a855f7" stroke-width="12" />

  <!-- Relógio de Parede / Calendário Digital -->
  <circle cx="256" cy="256" r="170" fill="none" stroke="url(#accentGrad)" stroke-width="20" stroke-linecap="round"/>
  
  <!-- Marcadores de Horas -->
  <circle cx="256" cy="116" r="10" fill="#00d2ff"/>
  <circle cx="396" cy="256" r="10" fill="#00d2ff"/>
  <circle cx="256" cy="396" r="10" fill="#00d2ff"/>
  <circle cx="116" cy="256" r="10" fill="#00d2ff"/>

  <!-- Ponteiros do Relógio -->
  <line x1="256" y1="256" x2="256" y2="160" stroke="#f0f6fc" stroke-width="18" stroke-linecap="round"/>
  <line x1="256" y1="256" x2="330" y2="256" stroke="#a855f7" stroke-width="18" stroke-linecap="round"/>
  <circle cx="256" cy="256" r="18" fill="#f0f6fc"/>

  <!-- Sino de Alerta Ativo -->
  <path d="M380 140 C380 120, 360 100, 340 100 C320 100, 300 120, 300 140 L300 170 L280 190 L400 190 L380 170 Z" fill="#ff7b00"/>
  <circle cx="340" cy="205" r="12" fill="#ff7b00"/>
</svg>
